# BSFChat chat server config.
#
# GENERATED FILE — do not edit. Edit ../.env and re-run ./setup.sh.
# The template lives at config/server.toml.template.

[server]
# The Matrix server name — this ends up inside every user ID (@you:HOST),
# so changing it later invalidates existing accounts. Get it right first.
name = "${CHAT_HOST}"
bind_address = "0.0.0.0"
port = 8448
# Concurrent CONNECTIONS the server can serve, not concurrent requests — see
# "Sizing the worker pool" in ../README.md before lowering either of these.
# Every signed-in client holds several sockets open at once, and a /sync long
# poll holds its one for the length of the poll.
workers = 64
max_workers = 512

[database]
# Absolute, and inside the /data volume mounted by docker-compose.yml.
# A relative path here would put the database in the container's writable
# layer, where it is destroyed on the next `docker compose up`.
#
# This file is NOT encrypted. It holds every message body in plaintext, a
# second copy of each body in the search index, queued push payloads and the
# audit log. Protect it with file permissions and by controlling who can read
# the host: the server chmods it (and its -wal/-shm siblings) to owner-only on
# every start, ./setup.sh chmods the containing directory to 0750, and
# ./backup.sh writes 0600 archives. Anyone who can read data/server/ can read
# every conversation on this server.
path = "/data/bsfchat.db"

[media]
path = "/data/media/"
# Kept in lockstep with client_max_body_size in nginx/bsfchat.conf — both
# are rendered from MAX_UPLOAD_MB in .env. If nginx's limit is lower, big
# uploads fail at the proxy with a 413 that the server never sees.
max_upload_size_mb = ${MAX_UPLOAD_MB}

[auth]
registration_enabled = ${REGISTRATION_ENABLED}

# PBKDF2-HMAC-SHA256 work factor as a POWER OF TWO: iterations = 2^cost.
# 19 => 524,288 iterations, in line with current OWASP guidance and matching
# the identity service's password_hash_iterations = 600000 in the same compose
# file.
#
# This template used to ship 12, which is 4,096 iterations — 128x weaker, and
# low enough that anyone who gets a copy of data/server/bsfchat.db cracks every
# password in a wordlist at GPU speed. If your deployment predates this change,
# raising it is safe and is the whole fix: each stored hash records the cost it
# was created with, so old hashes keep verifying, and the server re-derives at
# the new cost the next time each user logs in successfully. Nobody is locked
# out and nothing needs a reset.
#
# The cost of raising it is CPU per login, on the login path only: roughly
# 150-300ms per attempt on a small VPS instead of ~2ms. That is a feature (it
# is the same 128x tax on an attacker's offline guessing) but it does mean a
# server whose whole user base signs in at once after a restart does more work
# than it used to. Values below 12 are clamped up at startup; anything below 19
# logs a warning on every start.
password_hash_cost = 19

# Whose X-Forwarded-For the server believes when rate-limiting /login and
# /register. nginx runs on the HOST and reaches this container through the
# published 127.0.0.1:8448 port, so the peer the server sees is the Docker
# bridge gateway (172.x.0.1) — not loopback. Without the 172.16/12 entry every
# user shares one rate-limit bucket and one abusive client can lock everybody
# out of signing in. Safe because the port is published on 127.0.0.1 only:
# nothing but this host can reach the container from that range.
# (Ignored by server versions that predate auth rate limiting.)
#
# The other half of that: X-Forwarded-For from a peer NOT listed here is always
# ignored. That is deliberate — otherwise any client could name its own address
# and pick a fresh rate-limit bucket per request — but it is also why the
# symptom of getting this list wrong is a limiter that quietly applies to
# everyone at once instead of an error.
#
# So the list is a statement about which peers cannot forge a client address,
# and 172.16/12 only qualifies because of the 127.0.0.1 publish rule above. If
# you put something other than the bundled nginx in front — a proxy on another
# host, or a container on a user-defined network — replace that entry with the
# proxy's actual address. Never 0.0.0.0/0: that trusts every client to identify
# itself and the limiter stops existing. Unparseable entries fail startup
# rather than being silently dropped.
trusted_proxies = ["127.0.0.0/8", "::1", "172.16.0.0/12"]

# Public ranges you are deliberately trusting, and why.
#
# Behind a CDN this matters. Cloudflare terminates TLS at an edge node and
# nginx then appends that node's PUBLIC address to X-Forwarded-For, so the
# rightmost hop the server sees is Cloudflare, not your user. Leave the edge
# ranges untrusted and every user shares one bucket — the same outage the
# 172.16/12 entry above exists to prevent, one hop further out.
#
# Put them here rather than in trusted_proxies. This is the list, not a copy of
# it: entries are trusted identically, and there is nothing to keep in step.
# What the separate key buys you is that the server stops warning about THESE
# ranges specifically, and goes on warning about any public range you have not
# written here — including one added after this file was last reviewed.
#
# The reason is required for that to take effect. Nothing in the server fetches
# the list; refresh it yourself from https://www.cloudflare.com/ips-v4 and
# https://www.cloudflare.com/ips-v6 and move the date along when you do. If
# Cloudflare adds a range you have not got, users arriving through it share one
# bucket (the server's runtime "X-Forwarded-For from an untrusted peer" warning
# is the symptom). If Cloudflare gives one up, you carry on trusting it after
# it is reassigned — which is what the date is for.
#
# A range too wide to be an edge fleet — 0.0.0.0/0, ::/0, a public /8 — still
# warns from here. This key acknowledges a CDN; it is not an off switch.
#
# BETTER, IF YOU CAN: have nginx resolve the real client instead, so this
# server never trusts a public range at all. See the commented realip block in
# nginx/bsfchat.conf.template — it keeps the CDN list in ONE place (nginx) and
# leaves trusted_proxies at loopback + the bridge.
#
#   trusted_public_proxies = [ ...cloudflare.com/ips-v4 and ips-v6... ]
#   trusted_public_proxies_reason = "Cloudflare edge, refreshed 2026-09-20"
trusted_public_proxies = []
trusted_public_proxies_reason = ""

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# "local" writes to [media].path inside the /data volume. That is the right
# default for a self-hosted server: it works out of the box, it is one fewer
# service to run and back up, and docker-compose.yml ships no object store.
#
# To use S3-compatible object storage instead (AWS S3, MinIO, Backblaze B2,
# Contabo, Garage...), set type = "s3" and fill in the block below. You are
# responsible for running/renting that endpoint — nothing in this compose
# file provides one.
[storage]
type = "local"

# [storage.s3]
# endpoint = "https://s3.<region>.<provider>.tld"
# access_key = "..."
# secret_key = "..."
# bucket = "bsfchat-media"
# region = "us-east-1"
# use_path_style = true

# ---------------------------------------------------------------------------
# Voice
# ---------------------------------------------------------------------------
[voice]
enabled = true

# STUN and TURN are both served by the bundled coturn — one host, no
# third-party servers, no telemetry leaving your box.
stun_uri = "stun:${TURN_HOST}:${TURN_PORT}"

# TURN relay. Without it, users behind symmetric NAT or CGNAT cannot hear
# each other even though the call reports "connected".
#
# Two URIs are advertised, so each peer connection allocates two relay
# ports. That is accounted for in the coturn min-port/max-port range —
# see config/turnserver.conf.template before trimming the range.
turn_uri = [
  "turn:${TURN_HOST}:${TURN_PORT}?transport=udp",
  "turn:${TURN_HOST}:${TURN_PORT}?transport=tcp",
]

# Shared secret for ephemeral TURN credentials. Rendered from TURN_SECRET in
# .env, the same value coturn is started with — they cannot drift, and there
# is no placeholder here that "works" locally and fails across real NAT.
turn_secret = "${TURN_SECRET}"
# How long issued TURN credentials stay valid, in seconds.
turn_ttl = 3600

# Allow direct peer-to-peer as a fallback. Peers learn each other's IP, which
# is normal for a Discord/Teamspeak-style chat and avoids paying relay
# bandwidth for calls that do not need it. Set false to force every call
# through coturn (privacy over cost) — only do that once you have confirmed
# TURN actually works, or you turn off voice entirely.
allow_peer_to_peer = ${ALLOW_PEER_TO_PEER}

# ---------------------------------------------------------------------------
# Identity (BSFChat ID / OIDC)
# ---------------------------------------------------------------------------
[identity]
provider_url = "https://${ID_HOST}"
required = false
allow_local_accounts = true

# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------
# Nothing in docker-compose.yml provides a push gateway, so this ships off.
#
# Read the enabled = false comment before turning it on: /pushers/set is the
# one endpoint where an ordinary user hands this server a URL and this server
# then POSTs message data to it, which makes the allowlist a security control
# rather than a convenience. README.md, "Push notifications", has the rest —
# in particular why a gateway running inside this compose file needs TWO
# settings, not one.

[push]
# No push gateway is deployed. Push notifications are off.
# To enable: run sygnal (or equivalent), then set enabled = true and point
# allowed_gateway_prefixes at it. An empty allowlist means NO gateway is
# permitted — the server logs an error and disables push — because
# /pushers/set is the one endpoint where a user names a URL this server
# POSTs message data to.
enabled = false

# allowed_gateway_prefixes = ["https://push.${CHAT_HOST}/_matrix/push/v1/"]
# allow_internal_gateway = false   # true if sygnal runs inside compose
# default_payload = "event_id_only"  # "full" sends message bodies to the gateway
