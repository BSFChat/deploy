# Runtime state — media uploads, sqlite databases, letsencrypt certs etc.
# all land here at `docker compose up` time.
# Lives on the production host, never in git.
data/

# The actual secrets file — only .env.example is checked in.
.env
.env.tmp

# Config rendered by ./setup.sh from .env. The tracked sources are the
# *.template files next to them. These MUST stay ignored: config/server.toml
# contains the TURN shared secret, and committing a rendered config is how a
# deployment's real domain and secret end up in a public repo.
config/server.toml
config/identity.toml
config/turnserver.conf
nginx/bsfchat.conf

# The systemd unit rendered by ./setup.sh from the .template beside it. Not a
# secret — it names this deployment's directory and its retention period — but
# it is generated, and a committed copy would carry one host's absolute paths
# into everybody else's checkout.
systemd/bsfchat-backup.service

# Backup archives written by ./backup.sh. These are the single most sensitive
# artefact this deployment produces: a complete plaintext copy of every message,
# the OIDC signing key and the TURN secret. They belong nowhere near git.
backups/

# Editor scratch
*.swp
*~
.DS_Store
