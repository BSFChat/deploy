# /etc/nginx/sites-available/bsfchat
#
# GENERATED FILE — do not edit. Edit ../.env and re-run ./setup.sh.
# The template lives at nginx/bsfchat.conf.template.
#
# NOT VERIFIED BY `nginx -t` ANYWHERE IN THIS REPO. There is no nginx binary
# or image on the machines this is developed on, and all setup.sh checks is
# that no template placeholder survived rendering. The equivalent config was
# confirmed valid by hand on the production host, and the access-log regexes
# below were checked against PCRE with perl — but nginx itself has never
# parsed this exact file. Run `sudo nginx -t` after installing it and read
# what it says: a reload with a broken config leaves the old one serving and
# puts the complaint in the journal, which looks like nothing happened.
#
# ===========================================================================
#  READ THIS BEFORE GOING LIVE — origin TLS
# ===========================================================================
#  As shipped, this file listens on port 80 only. That is fine while you are
#  getting a certificate, and NOT fine afterwards.
#
#  If you put Cloudflare (or any other CDN) in front of a plaintext origin
#  and leave its SSL/TLS mode on "Flexible", the padlock your users see is a
#  lie: the CDN-to-origin leg is unencrypted HTTP across the public internet.
#  Anyone on that path — the hosting provider, a transit network, whoever
#  runs the rack — reads every message, media upload and access token in
#  clear text. For a product whose pitch is self-hosting and not trusting
#  someone else's servers, that is the whole thing undone.
#
#  Do this instead:
#    1. Get a certificate on the origin:
#         sudo apt install certbot python3-certbot-nginx
#         sudo certbot --nginx -d ${CHAT_HOST} -d ${ID_HOST}
#       (the ACME location block below keeps webroot renewals working)
#    2. Uncomment the TLS server blocks at the bottom of this file, and the
#       `return 301` lines in the port-80 blocks.
#    3. If you use Cloudflare, set SSL/TLS mode to **Full (strict)**.
#       "Flexible" is never the right answer here.
# ===========================================================================

# ===========================================================================
#  ACCESS LOGGING — do not remove the `bsfchat` format below
# ===========================================================================
#  nginx's built-in `combined` format logs $request, which is the raw request
#  line INCLUDING the query string. The desktop client fetches media with the
#  session token as a query parameter — the image and video widgets cannot set
#  an Authorization header — so every media request written by the default
#  format puts a working bearer token on disk in /var/log/nginx/access.log,
#  readable by anyone in the adm group and copied into every rotated archive.
#
#  The map below rewrites the URI for logging only: the request nginx proxies
#  upstream is untouched, and $request_uri is still the real thing everywhere
#  else. Only the logged copy is redacted.
#
#  This file is included from inside nginx.conf's `http { }` block, which is
#  why `map` and `log_format` are legal at the top of it.
#
#  Three things to know:
#
#   1. The map already lists `mt=` alongside `access_token=`. The
#      token-out-of-URL work replaces ?access_token= with a short-lived
#      ticket in a second query parameter — a smaller exposure, but still a
#      credential and still not something that belongs in a log line, so it
#      is redacted from the day that release lands rather than from the day
#      somebody remembers to edit this file. See "The redaction itself"
#      below for how to add the next one.
#
#   2. THE FIX IS FORWARD-ONLY. Every access log already written, and every
#      rotated archive of one, contains live bearer tokens — and because token
#      expiry slides forward on use, a line from last week can still work
#      today. Rotating the logs is part of deploying this change, not an
#      afterthought:
#           sudo truncate -s 0 /var/log/nginx/access.log
#           sudo rm -f /var/log/nginx/access.log.*.gz /var/log/nginx/access.log.?
#      Then make everyone re-authenticate if you have any reason to think a
#      copy left the host. See "Backup and restore" in ../README.md —
#      ./backup.sh deliberately does not sweep up /var/log, precisely so it
#      cannot turn a log-rotation problem into a backup-retention problem.
#
#   3. The ERROR log is a residual this cannot fully close. Read on.
#
# ===========================================================================
#  ERROR LOGGING — what is left, and why it is not fixed here
# ===========================================================================
#  The map above fixes the access log and nothing else. nginx's error log has
#  no `log_format` equivalent: entries carry a `, request: "GET /uri?... HTTP/
#  1.1"` suffix built from the request line exactly as it arrived, and no
#  directive changes it. Rewrites do not reach it either — an internal rewrite
#  changes the URI nginx works with, not the request line it received and
#  reports. So a token in the URL cannot be scrubbed out of the error log. It
#  can only be prevented from getting into the URL, or suppressed.
#
#  Be precise about the exposure, because "every 4xx writes a token" is wrong.
#  At the default `error` level a routine 404 or 403 is not an error-log event
#  at all — those are access-log only. What does write an error-level entry
#  WITH the request line, on a request that may carry ?access_token=:
#
#    * 413, when a body exceeds client_max_body_size
#        ("client intended to send too large body")
#    * 502/504 and friends, when the upstream fails or times out
#        ("upstream timed out", "connect() failed", "upstream prematurely
#         closed connection")
#
#  Both are already rare here, and not by accident — two existing decisions in
#  this file happen to be the mitigation:
#
#    * client_max_body_size is rendered at MAX_UPLOAD_MB + 8 (setup.sh), so an
#      oversized upload is refused by the SERVER with a JSON error rather than
#      by nginx with a 413. The 413 path is reached only by a body larger than
#      the server's own limit plus 8MB.
#    * proxy_read_timeout is 330s, above the server's 300s long-poll cap, so a
#      /sync long poll completing normally does not become a 504.
#
#  What is left is genuinely occasional: a restart or crash of the chat server
#  while media requests are in flight, which logs one line per in-flight
#  request, with the token. Low volume, not zero, and every one of those tokens
#  is live — expiry slides forward on use, so an old line can still work.
#
#  THE REAL FIX IS THE TOKEN LEAVING THE URL. Signed media tickets replace
#  ?access_token= with a short-lived, single-purpose ticket; that is scheduled
#  for the release after this one. The access-log map above already covers
#  `mt=`, but revisit THIS block when it lands — a ticket in an error-log
#  line is a much smaller problem than a session token, but it is still a
#  credential on disk, and nothing here redacts it.
#
#  Until then, the one lever available is suppression, and it costs you the
#  diagnostics for exactly the failures you would want to debug. It is NOT
#  enabled by default: a media path that fails silently is its own incident,
#  and this is a low-volume residue with a scheduled fix. Enable it only if you
#  have decided tokens-on-disk is the bigger risk for your deployment.
#
#  To suppress, uncomment the error_log line in the chat server's `location /`
#  below. `crit` keeps crit/alert/emerg and drops everything at `error`,
#  including the two cases above. It applies to the whole proxied chat API, so
#  you also lose upstream diagnostics for /sync, /login and everything else.
#  If that is too blunt, split the media paths into their own location — a copy
#  of `location /` at `/_matrix/media/` with the raised error_log — and accept
#  that the two blocks now have to be kept in step by hand.
#
#  Whichever you choose, VERIFY IT. Stop the chat server, request a media URL
#  with a token, and confirm nothing landed in error.log:
#      docker compose stop server
#      curl -s -o /dev/null 'http://127.0.0.1/_matrix/media/v3/download/x/y?access_token=VERIFYME'
#      docker compose start server
#      sudo grep -c VERIFYME /var/log/nginx/error.log      # want: 0
#
#  And rotate what is already there, the same as the access log — see item 2.
#  Existing error.log archives hold tokens no config change can retract:
#      sudo truncate -s 0 /var/log/nginx/error.log
#      sudo rm -f /var/log/nginx/error.log.*.gz /var/log/nginx/error.log.?
# ===========================================================================

# ---------------------------------------------------------------------------
#  The redaction itself — two passes, and why
# ---------------------------------------------------------------------------
#  Pass 1 replaces the value of the first credential parameter with
#  <redacted> and keeps everything around it. That is a change: the version
#  this replaces captured the trailing parameters and then never used the
#  capture, so a thumbnail request logged as a bare `?<redacted>` with no
#  width, height or method. Safe, but it threw away the only signal you have
#  when media starts 404ing or coming back the wrong size.
#
#  One regex can redact only one occurrence, so pass 2 is the backstop: if
#  anything credential-shaped is still there after pass 1 — two access_token
#  parameters, or a token and a ticket in the same URI — it throws the whole
#  query string away. Over-redacting a strange URI beats logging a token, and
#  a URI carrying two credentials is strange.
#
#  TO ADD A PARAMETER, add it to the (?:access_token|mt) alternation in BOTH
#  maps. They have to stay identical: pass 2 is what makes pass 1 safe to
#  splice. `mt` — the signed media ticket arriving next release — is listed
#  already. It costs nothing until the server starts sending it, and listing
#  it now means no deployment ends up redacting tokens but not tickets
#  because the conf was not re-copied on upgrade.
#
#  A parameter only matches where its name starts immediately after `?` or
#  `&` and is followed by `=`, so `my_access_token=`, `access_tokens=` and
#  `xmt=` are left alone, and an encoded `%26access_token%3D` inside some
#  other parameter's value stays one opaque value rather than becoming a
#  separator plus a credential.
#
#  There is no nginx on the build machines, but PCRE is PCRE — check a change
#  to the alternation with perl before you ship it:
#
#    perl -e '$u=shift;
#      $u =~ s/^([^?]*)\?((?:[^&]*&)*?)(?:access_token|mt)=[^&]*/$1?$2<redacted>/;
#      $u = "$1?<redacted>" if $u =~ m{^([^?]*)\?(?:[^&]*&)*(?:access_token|mt)=};
#      print "$u\n"' '/m?width=96&access_token=SECRET&height=96'
#    # want: /m?width=96&<redacted>&height=96
# ---------------------------------------------------------------------------

map $request_uri $loggable_uri_once {
    ~^(?<lu_path>[^?]*)\?(?<lu_pre>(?:[^&]*&)*?)(?:access_token|mt)=[^&]*(?<lu_post>(?:&.*)?)$
        "$lu_path?$lu_pre<redacted>$lu_post";
    default
        $request_uri;
}

map $loggable_uri_once $loggable_uri {
    ~^(?<lu_path2>[^?]*)\?(?:[^&]*&)*(?:access_token|mt)=
        "$lu_path2?<redacted>";
    default
        $loggable_uri_once;
}

log_format bsfchat '$remote_addr - $remote_user [$time_local] '
                   '"$request_method $loggable_uri $server_protocol" '
                   '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# --- chat server (port 80) -------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${CHAT_HOST};

    access_log /var/log/nginx/access.log bsfchat;

    # Keep this reachable over plain HTTP even after you enable the redirect
    # below, or certificate renewal breaks.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Uncomment once the TLS block below is live:
    # location / { return 301 https://$host$request_uri; }

    client_max_body_size ${NGINX_MAX_BODY_MB}M;

    location / {
        # Uncomment to keep session tokens out of the error log, at the cost of
        # every error-level diagnostic for the chat API (413s, upstream
        # failures and timeouts). Read "ERROR LOGGING" at the top of this file
        # first — this is a deliberate trade, not a free win, and the real fix
        # arrives with signed media tickets.
        # error_log /var/log/nginx/error.log crit;

        proxy_pass http://127.0.0.1:8448;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /sync long-polling. The server caps a long-poll at
        # kMaxSyncTimeoutMs = 300s (protocol/include/bsfchat/Constants.h), so
        # anything at or below 300s here cuts live connections mid-poll and
        # clients see spurious disconnects. Must stay > 300s.
        proxy_read_timeout 330s;
        proxy_send_timeout 330s;

        # Long-polls and media streaming should not sit in an nginx buffer.
        proxy_buffering off;
        proxy_request_buffering off;
    }
}

# --- identity service (port 80) --------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${ID_HOST};

    access_log /var/log/nginx/access.log bsfchat;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Uncomment once the TLS block below is live:
    # location / { return 301 https://$host$request_uri; }

    location / {
        proxy_pass http://127.0.0.1:8480;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

