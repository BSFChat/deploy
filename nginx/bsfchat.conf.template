# --- chat server (port 80) -------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${CHAT_HOST};

    access_log /var/log/nginx/access.log bsfchat;

    # Keep this reachable over plain HTTP even after you enable the redirect
    # below, or certificate renewal breaks.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Once the TLS block below is live, this server block should redirect and
    # proxy nothing. DELETE everything from `client_max_body_size` to the end
    # of this block and put this in its place — do not simply add it:
    #
    #     location / { return 301 https://$host$request_uri; }
    #
    # Two ways to get this wrong. Adding it while `location /` is still here
    # is a duplicate location, and nginx refuses to load the file at all —
    # `nginx -t` says so. The quieter one is adding the redirect and leaving
    # the /sync block behind: `location = /_matrix/client/v3/sync` is an exact
    # match and outranks the prefix `location /`, so every long poll would go
    # on being served over plaintext HTTP while everything else redirected,
    # and it would look like it was working.
    #
    # The ACME location above stays either way, or renewal breaks.

    client_max_body_size ${NGINX_MAX_BODY_MB}M;

    # ── Proxy settings shared by both locations below ───────────────────────
    # These live at SERVER level, not inside `location /`, because nginx
    # inherits a directive from the ENCLOSING block — a `location = /...` does
    # NOT inherit from `location /`. Server level is the only place that
    # reaches both, and putting them here is what stops the long-poll location
    # and the general one drifting apart the next time a header is added.
    #
    # One trap worth knowing: proxy_set_header is all-or-nothing. A location
    # that sets a single header of its own silently loses all four inherited
    # ones, and the chat server then sees no X-Forwarded-For at all. If you
    # need a header on one location, repeat the whole set there.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Long polls and media streaming should not sit in an nginx buffer.
    proxy_buffering off;
    proxy_request_buffering off;

    # The default for every proxied request EXCEPT the long poll, which
    # overrides it below. Read "LONG-POLL TIMEOUTS" at the top of this file
    # for the incident these numbers come from.
    #
    # Why this is scoped instead of 330s everywhere: 330s is the right answer
    # for the one endpoint that is DESIGNED to hang, and the wrong answer for
    # every other endpoint, where a hang means the chat server is wedged. With
    # 330s on everything, a wedged upstream holds each arriving connection for
    # five and a half minutes before anyone is told anything; at 120s the same
    # failure surfaces as a 504 in two. 120s is still far above any honest
    # request here — the slowest is a MAX_UPLOAD_MB media transfer over
    # loopback — so in normal operation this never fires.
    #
    # Note this is NOT the slow-loris lever; see the header block. Client-side
    # patience is client_header_timeout / client_body_timeout / send_timeout,
    # left at their 60s defaults.
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    # ── The long poll ───────────────────────────────────────────────────────
    # The only endpoint that needs the big timeout. Exact match: nothing else
    # blocks server-side (the voice endpoints return immediately — the client
    # polls them by repeating the request), and a query string does not affect
    # location matching, so ?timeout=300000&since=... lands here.
    #
    # 330s = kMaxSyncTimeoutMs (300s) + 30s of margin. It MUST stay above
    # 300s: at or below it, a poll that runs to the server's own cap is cut by
    # nginx first and the client receives an HTML 504 instead of a sync
    # response — the failure described at the top of this file. The margin
    # covers writing a large response out over a slow link after the poll has
    # already used its full budget.
    #
    # proxy_send_timeout is raised alongside it for symmetry rather than
    # necessity: a /sync GET carries no request body, so nginx is never slow
    # at sending one and this cannot fire. It is here so the pair does not
    # look half-edited to whoever reads it next.
    location = /_matrix/client/v3/sync {
        # Keep this in step with the error_log line in `location /` below:
        # since the split, uncommenting it there no longer covers /sync, and
        # /sync is where upstream-timeout errors actually come from.
        # error_log /var/log/nginx/error.log crit;

        proxy_pass http://127.0.0.1:8448;
        proxy_read_timeout 330s;
        proxy_send_timeout 330s;
    }

    location / {
        # Uncomment to keep session tokens out of the error log, at the cost of
        # every error-level diagnostic for the chat API (413s, upstream
        # failures and timeouts). Read "ERROR LOGGING" at the top of this file
        # first — this is a deliberate trade, not a free win, and the real fix
        # arrives with signed media tickets. Uncomment it in the /sync block
        # above too, or that path keeps logging.
        # error_log /var/log/nginx/error.log crit;

        proxy_pass http://127.0.0.1:8448;
    }
}

# --- identity service (port 80) --------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${ID_HOST};

    access_log /var/log/nginx/access.log bsfchat;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Once the TLS block below is live, REPLACE the `location /` below with:
    #     location / { return 301 https://$host$request_uri; }
    # Replace, not add — two `location /` blocks is a config nginx refuses to
    # load. The ACME location above stays, or renewal breaks.

    # No proxy_read_timeout here on purpose. The identity service has no
    # long-poll endpoint — every route is a short OIDC request — so nginx's
    # 60s default is correct, and raising it would only delay the moment you
    # find out the identity container is wedged. If you ever add a blocking
    # endpoint here, it needs its own location block and the reasoning at the
    # top of this file applies to it.
    location / {
        proxy_pass http://127.0.0.1:8480;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

