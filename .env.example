# BSFChat deployment settings — the single place you edit.
#
#   cp .env.example .env
#   $EDITOR .env
#   ./setup.sh          # renders config/*.toml and nginx/bsfchat.conf
#   docker compose up -d
#
# Re-run ./setup.sh after ANY change here: the generated config files are
# what the services actually read.

# ---------------------------------------------------------------------------
# Domains
# ---------------------------------------------------------------------------
# CHAT_HOST becomes the Matrix server name, so it is baked into every user ID
# (@you:chat.example.com). Changing it later invalidates existing accounts —
# decide before your first start.
CHAT_HOST=chat.example.com
ID_HOST=id.example.com

# Hostname clients use to reach coturn. Usually the same box; a dedicated
# record (turn.example.com) is tidier and lets you move the relay later.
TURN_HOST=turn.example.com

# ---------------------------------------------------------------------------
# TURN / voice  (required — voice does not work without these)
# ---------------------------------------------------------------------------
# Shared secret used to sign short-lived TURN credentials. ./setup.sh fills
# this in with `openssl rand -hex 32` if you leave it empty, and docker
# compose refuses to start coturn while it is unset. Do not invent one by
# hand and do not reuse it anywhere else.
TURN_SECRET=

# The PUBLIC IPv4 address of this machine. Mandatory.
#
# Almost every VPS (AWS, GCP, Hetzner, DO, Contabo, OVH...) gives the guest a
# private address behind a 1:1 NAT. coturn hands clients whatever address it
# sees on its interface, so without this it advertises 10.x/172.x/192.168.x
# as the relay candidate and every relayed call fails — with no error in any
# log, because the allocation itself succeeded.
#
# Find it with:   curl -4 https://ifconfig.me
# If the machine has a genuine public IP directly on its NIC, set the same
# value here anyway; it is a no-op.
# If the public and private addresses differ and coturn needs both:
#   TURN_EXTERNAL_IP=203.0.113.10/10.0.0.5
TURN_EXTERNAL_IP=

# STUN/TURN listener port and relay range. The relay range must be large:
# a call of N people allocates N*(N-1)*2 ports (two TURN URIs are
# advertised). ~2000 ports covers several concurrent large calls.
# Open on your firewall: TURN_PORT tcp+udp, and the whole range udp.
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=51160

# Realm for the TURN digest auth exchange. Not DNS-resolved; just has to
# match on both sides, which ./setup.sh guarantees.
TURN_REALM=chat.example.com

# Set to false to force every call through the relay (peers never learn each
# other's IP) at the cost of relay bandwidth. Leave true unless you have
# verified TURN works end to end — false with broken TURN means no voice
# at all.
ALLOW_PEER_TO_PEER=true

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# One number, applied to both the server and the nginx proxy in front of it.
# Setting them independently is how you get uploads that fail at the proxy
# with a 413 the server never sees.
MAX_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# Open registration. Turn this off after creating your accounts if the
# server is on the public internet.
REGISTRATION_ENABLED=true

# ---------------------------------------------------------------------------
# Images  (release channel)
# ---------------------------------------------------------------------------
# Which published tag the server and identity images are pulled from. The
# same value is used for both — they release in lockstep and running a
# stable server against a beta identity service is not a configuration
# anyone tests.
#
#   latest        STABLE. The highest released version. This is the default
#                 and what you want unless you have a reason otherwise.
#
#   latest-beta   BETA. The highest of stable *or* release candidate, so it
#                 is never behind `latest` — it is stable plus the RCs on
#                 their way to becoming stable. Pair it with the beta
#                 channel in the desktop client (Settings -> Updates).
#
#   main          DEVELOPMENT. Tip of the branch, rebuilt on every push.
#                 Unreviewed and untagged. For people working on BSFChat.
#
#   v0.1.0        A specific release, pinned. Never moves.
#
# `latest` follows the HIGHEST version, not the most recently published
# one, so a hotfix cut on an older line cannot silently downgrade you.
# See server/docs/release-channels.md.
#
# NOTE: `latest` used to mean tip-of-main. If you are on an install from
# before release channels existed, read the "Switching channels" section of
# README.md before your next `docker compose pull`.
BSFCHAT_TAG=latest
# coturn is internet-facing and terminates untrusted UDP/TCP — always pinned,
# never :latest. Bump deliberately after checking advisories.
COTURN_TAG=4.11.0
